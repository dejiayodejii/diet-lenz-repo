{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Diet Lenz Dev",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--flavor",
        "development",
        "--dart-define=ENVIRONMENT=development",
        "--dart-define=API_URL=https://diet-lenz-stagingapi-d3mbl.ondigitalocean.app"
      ]
    },
    {
      "name": "Diet Lenz Staging",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "--flavor",
        "staging",
        "--dart-define=ENVIRONMENT=staging",
        "--dart-define=API_URL=https://diet-lenz-stagingapi-d3mbl.ondigitalocean.app"
      ]
    },
    {
      "name": "Diet Lenz Production",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
