fastlane_version "2.0.0"

default_platform(:ios)

# ────────────────────────────────────────────────────────────────────────────
# Shared helpers
# ────────────────────────────────────────────────────────────────────────────

def app_store_connect_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
    is_key_content_base64: false,
    in_house: false,
  )
end

# ────────────────────────────────────────────────────────────────────────────
# iOS
# ────────────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Run iOS tests using the Development scheme"
  lane :test_ios do
    run_tests(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Development",
      devices: ["iPhone 15"],
    )
  end

  desc "Build a staging iOS IPA using ad-hoc signing"
  lane :build_staging_ios do
    api_key = app_store_connect_api_key

    match(
      type: "adhoc",
      app_identifier: "com.dietlenz.diet.staging",
      api_key: api_key,
      readonly: is_ci,
    )

    build_number = ENV["BUILD_NUMBER"] || number_of_commits

    # Use flutter build so --dart-define values reach String.fromEnvironment()
    sh "flutter build ipa " \
       "--flavor staging " \
       "--dart-define=ENVIRONMENT=staging " \
       "--dart-define=API_URL=https://diet-lenz-stagingapi-d3mbl.ondigitalocean.app " \
       "--build-number=#{build_number} " \
       "--export-options-plist=ios/ExportOptions-AdHoc.plist"
  end

  desc "Build a production iOS IPA using App Store signing"
  lane :build_production_ios do
    api_key = app_store_connect_api_key

    match(
      type: "appstore",
      app_identifier: "com.dietlenz.diet",
      api_key: api_key,
      readonly: is_ci,
    )

    build_number = ENV["BUILD_NUMBER"] || number_of_commits

    # Use flutter build so --dart-define values reach String.fromEnvironment()
    sh "flutter build ipa " \
       "--flavor production " \
       "--dart-define=ENVIRONMENT=production " \
       "--dart-define=API_URL=https://dietlenz-prod-api-9mcsl.ondigitalocean.app " \
       "--build-number=#{build_number} " \
       "--export-options-plist=ios/ExportOptions-AppStore.plist"
  end

  desc "Build staging and distribute to Firebase App Distribution"
  lane :distribute_staging_ios do
    build_staging_ios

    firebase_app_distribution(
      app: ENV["FIREBASE_IOS_APP_ID"],
      groups: "qa-team",
      release_notes: "Staging build from CI — branch: #{git_branch}, commit: #{last_git_commit[:abbreviated_commit_hash]}",
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
    )
  end

  desc "Build production and upload to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key
    build_production_ios

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

end

# ────────────────────────────────────────────────────────────────────────────
# Android
# ────────────────────────────────────────────────────────────────────────────

platform :android do

  desc "Run Android unit tests"
  lane :test_android do
    gradle(
      task: "test",
      build_type: "Debug",
      project_dir: "android",
    )
  end

  desc "Build a staging APK"
  lane :build_staging_android do
    build_number = ENV["BUILD_NUMBER"] || number_of_commits

    # Use flutter build so --dart-define values reach String.fromEnvironment()
    sh "flutter build apk " \
       "--flavor staging " \
       "--dart-define=ENVIRONMENT=staging " \
       "--dart-define=API_URL=https://diet-lenz-stagingapi-d3mbl.ondigitalocean.app " \
       "--build-number=#{build_number}"
  end

  desc "Build a production AAB"
  lane :build_production_android do
    build_number = ENV["BUILD_NUMBER"] || number_of_commits

    # Use flutter build so --dart-define values reach String.fromEnvironment()
    sh "flutter build appbundle " \
       "--flavor production " \
       "--dart-define=ENVIRONMENT=production " \
       "--dart-define=API_URL=https://dietlenz-prod-api-9mcsl.ondigitalocean.app " \
       "--build-number=#{build_number}"
  end

  desc "Build staging and distribute to Firebase App Distribution"
  lane :distribute_staging_android do
    build_staging_android

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      groups: "qa-team",
      release_notes: "Staging build from CI — branch: #{git_branch}, commit: #{last_git_commit[:abbreviated_commit_hash]}",
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "android/app/build/outputs/apk/staging/release/app-staging-release.apk",
    )
  end

  desc "Build production AAB and upload to Play Store internal track"
  lane :upload_play_store_internal do
    build_production_android

    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/productionRelease/app-production-release.aab",
      release_status: "draft",
    )
  end

end
